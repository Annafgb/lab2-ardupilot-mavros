<launch>
  <!-- SITL, Mission Planner і MAVROS мають уже працювати.
       Свої координати: roslaunch lab_shyliuk mission_ap.launch config:=/шлях/до/route.yaml -->
  <arg name="config" default="$(find lab_shyliuk)/config/mission_ap.yaml"/>
  <arg name="csv" default="$(env HOME)/mission_ap_log.csv"/>
  <node pkg="lab_shyliuk" type="mission_ap" name="mission_ap" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="csv" value="$(arg csv)"/>
  </node>
</launch>
